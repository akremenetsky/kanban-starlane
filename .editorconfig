root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Board files are byte-exact fixtures: never touch their whitespace.
[{tests/fixtures/**,tests/e2e/vaults/**,test-vault/**}]
insert_final_newline = unset
trim_trailing_whitespace = false
