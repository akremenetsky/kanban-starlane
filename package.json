{
  "name": "kanban-starlane",
  "version": "0.1.4",
  "description": "Manage tasks and projects on Kanban boards stored as plain markdown",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "install-plugin": "node scripts/install-plugin.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.mjs\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tests/**/*.{ts,tsx}\" \"*.mjs\" \"scripts/*.mjs\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run lint:scanner && npm run format:check && npm run test",
    "rlnotes": "git log $(git describe --tags --abbrev=0)..HEAD --oneline > release-notes.md && git add release-notes.md",
    "bump": "node scripts/version-bump.mjs && git add package.json manifest.json versions.json && npm run rlnotes",
    "test:update-fixtures": "UPDATE_FIXTURES=1 vitest run tests/unit/format/roundtrip.test.ts",
    "test:e2e": "npm run build && node scripts/e2e.mjs",
    "docs:install": "python3 -m venv .venv-docs && .venv-docs/bin/pip install -q -r requirements-docs.txt",
    "docs:serve": ".venv-docs/bin/zensical serve",
    "docs:build": ".venv-docs/bin/zensical build",
    "lint:scanner": "node scripts/scanner-lint.mjs"
  },
  "keywords": [],
  "author": "Anton Kremenetsky",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@codemirror/commands": "^6.0.0",
    "@codemirror/state": "^6.0.0",
    "@codemirror/view": "^6.0.0",
    "@eslint-react/eslint-plugin": "^5.23.5",
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^4.3.0",
    "@types/box-intersect": "^1.0.0",
    "@types/mark.js": "^8.11.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "esbuild": "^0.28.2",
    "esbuild-plugin-less": "^1.3.39",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "jsdom": "^26.1.0",
    "magic-string": "^0.30.10",
    "mocha": "^12.0.2",
    "obsidian": "^1.5.7-1",
    "prettier": "^3.9.9",
    "tslib": "^2.6.2",
    "typescript": "~5.9",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "wdio-obsidian-reporter": "^3.2.1",
    "wdio-obsidian-service": "^3.2.1",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@tanstack/match-sorter-utils": "^8.15.1",
    "@tanstack/react-table": "^8.11.2",
    "animated-scroll-to": "^2.2.0",
    "box-intersect": "^1.0.2",
    "choices.js": "9.0.1",
    "classcat": "^5.0.3",
    "colord": "^2.9.3",
    "deepmerge": "^4.2.2",
    "eventemitter3": "^5.0.1",
    "file-selector": "^0.2.4",
    "immutability-helper": "^3.1.1",
    "mark.js": "^8.11.1",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^1.0.2",
    "mdast-util-frontmatter": "^1.0.0",
    "mdast-util-to-string": "^3.1.0",
    "micromark-extension-frontmatter": "^1.1.1",
    "micromark-factory-space": "^1.1.0",
    "micromark-util-character": "^1.1.0",
    "micromark-util-symbol": "^1.1.0",
    "micromark-util-types": "^1.0.1",
    "monkey-around": "^2.1.0",
    "obsidian-daily-notes-interface": "^0.9.4",
    "preact": "^10.8.2",
    "react": "npm:@preact/compat",
    "react-colorful": "^5.6.1",
    "react-cool-onclickoutside": "^1.6.1",
    "react-dom": "npm:@preact/compat",
    "react-fast-compare": "^3.2.2",
    "rrule": "^2.8.1",
    "unist-util-visit": "^4.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "moment": "2.31.0"
  }
}
